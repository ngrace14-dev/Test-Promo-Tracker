rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is logged in and is in the authorized list
    function isAuthorizedManager() {
      return request.auth != null && (
        request.auth.token.email == 'nicholas.grace@rredco.com' ||
        request.auth.token.email == 'accounting@rredco.com'
      );
    }

    // Explicitly lock down the collections you use
        // Brands: Read allowed for specific brand via portal if access code matches
        match /brands/{brandId} {
          allow read, write: if isAuthorizedManager();
          allow read: if true; // Temporary for portal login lookup
        }

        // Reports: Published by Admin, Read by Brands
        match /reports/{reportId} {
          allow read, write: if isAuthorizedManager();
          allow read: if true; // Brands filter by ID in app logic
        }

        // Credit Requests: Submitted by Brands, Managed by Admin
        match /creditRequests/{requestId} {
          allow read, write: if isAuthorizedManager();
          allow read, create: if true; // Brands can create and read their own
        }

        // Documents: Uploaded by Brands/Admin
        match /documents/{docId} {
          allow read, write: if isAuthorizedManager();
          allow read, create: if true; 
        }

        // Promo & Status Definitions: Read-only for Brands, Managed by Admin
        match /promoDefinitions/{id} {
          allow read: if true;
          allow write: if isAuthorizedManager();
        }
        match /statusDefinitions/{id} {
          allow read: if true;
          allow write: if isAuthorizedManager();
        }

        // Activity Log: Non-negotiable audit trail
        match /activityLog/{logId} {
          allow create: if true;
          allow read: if true;
        }

                match /vendorMappings/{vendorId} {
          allow read: if true;
          allow write: if isAuthorizedManager();
        }
        match /brandMappings/{brandId} {
          allow read: if true;
          allow write: if isAuthorizedManager();
        }
        match /siteMappings/{siteId} {
          allow read: if true;
          allow write: if isAuthorizedManager();
        }
        match /mappingQueue/{queueId} {
          allow read: if true;
          allow write: if isAuthorizedManager();
        }

        // Promo Credits: Legacy collection (maintaining for backward compatibility)
    match /promoCredits/{creditId} {
      allow read, write: if isAuthorizedManager();
      allow read: if request.auth == null && resource.data.vendor != null; 
    }

    // Sales Data: Read allowed for brands
    match /treesSales/{saleId} {
      allow read, write: if isAuthorizedManager();
      allow read: if request.auth == null && resource.data.brand != null;
    }

    // System Logs: Anyone authorized can write, only Nicholas can read/delete
    match /systemLogs/{logId} {
      allow create: if isAuthorizedManager();
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'nicholas.grace@rredco.com';
    }

    match /emailHistories/{historyId} {
      allow read, write: if isAuthorizedManager();
    }
    
    // Deny access to everything else in the database
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
